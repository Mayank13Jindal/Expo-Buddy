# Generated IDs and secrets are deliberately absent. Use ./scripts/docker.sh setup to generate .env; this file documents the options.
# For local Docker setup: ./scripts/docker.sh setup
APP_URL=https://localhost:8443
APP_HOST=localhost
APP_AUTHORITY=localhost:8443
APP_UID=1000
APP_GID=1000
GATEWAY_BIND=127.0.0.1
GATEWAY_HTTPS_PORT=8443
GATEWAY_HTTP_PORT=8080
# tls internal is for local testing. Configure trusted HTTPS before phone use.
CADDY_TLS=internal
APP_TIMEZONE=UTC
ASSETS_DIR=/mnt/hdd/expo-buddy/originals
PREVIEWS_DIR=/srv/ssd/expo-buddy/previews
DB_DIR=/srv/ssd/expo-buddy/db
MODELS_DIR=/srv/ssd/expo-buddy/models
EXPORTS_DIR=/mnt/hdd/expo-buddy/exports
BACKUP_DIR=/mnt/backup/expo-buddy
# Each ID must match that directory's .expo-buddy-volume file.
ASSETS_VOLUME_ID=
PREVIEWS_VOLUME_ID=
DB_VOLUME_ID=
MODELS_VOLUME_ID=
EXPORTS_VOLUME_ID=
BACKUP_VOLUME_ID=
# Optional expected host mount points (the mount root, not a subdirectory).
ASSETS_MOUNT=/mnt/hdd
PREVIEWS_MOUNT=/srv/ssd
DB_MOUNT=/srv/ssd
MODELS_MOUNT=/srv/ssd
EXPORTS_MOUNT=/mnt/hdd
BACKUP_MOUNT=/mnt/backup
SECRETS_DIR=/absolute/path/outside/database/.secrets
ASSETS_FREE_FLOOR_BYTES=5368709120
STORAGE_CHECK_SECONDS=30
ALLOW_SHARED_BACKUP_DISK=false
IMAGE_LIMIT_BYTES=104857600
PDF_LIMIT_BYTES=419430400
PDF_PAGE_LIMIT=200
# Multipart overhead above the 400 MiB PDF limit.
GATEWAY_BODY_LIMIT=423624704
# Set only after collecting the owner's Ollama URL; no new Ollama is installed.
OLLAMA_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=600


DATABASE_NAME=expo
EXPORT_TTL_DAYS=7

# Anyone who can reach the app can access it when true. Keep it on a trusted LAN/VPN.
PASSWORDLESS=true

# Local OpenAI callback for browsers on the server PC; published only on 127.0.0.1.
CHATGPT_CALLBACK_PORT=1455
